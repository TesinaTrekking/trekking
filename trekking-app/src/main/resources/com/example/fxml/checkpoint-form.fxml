<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane id="checkpoint-form" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="pantalla-scroll" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.CheckpointFormController" stylesheets="@styles.css">
  <content>
    <VBox alignment="TOP_CENTER" styleClass="form-page">
      <VBox styleClass="form-content">
        <Label fx:id="tituloLabel" text="Nuevo Checkpoint" styleClass="dialog-header-title" />
        <Label fx:id="subtituloLabel" text="Completa los datos del punto de control de la Ruta." styleClass="dialog-header-subtitle" wrapText="true" />
        <VBox styleClass="form-card">
          <Label text="Datos del Checkpoint" styleClass="form-section-title" />
          <VBox spacing="12" styleClass="checkpoint-form-fields">
            <VBox styleClass="form-field">
              <Label text="Nombre *" styleClass="form-label" />
              <TextField fx:id="txtNombre" promptText="Ej. Refugio de montaña" />
            </VBox>
            <VBox styleClass="form-field">
              <Label text="Hora *" styleClass="form-label" />
              <TextField fx:id="txtHora" promptText="HH:mm" />
              <Label text="Formato de 24 horas. Ejemplo: 14:30." styleClass="field-help" wrapText="true" />
            </VBox>
            <VBox styleClass="form-field">
              <Label text="Latitud *" styleClass="form-label" />
              <TextField fx:id="txtLatitud" promptText="Ej. -31.4135" />
              <Label text="Grados decimales, entre -90 y 90." styleClass="field-help" wrapText="true" />
            </VBox>
            <VBox styleClass="form-field">
              <Label text="Longitud *" styleClass="form-label" />
              <TextField fx:id="txtLongitud" promptText="Ej. -64.1810" />
              <Label text="Grados decimales, entre -180 y 180." styleClass="field-help" wrapText="true" />
            </VBox>
            <VBox styleClass="form-field">
              <Label text="Altitud (m) *" styleClass="form-label" />
              <TextField fx:id="txtAltitud" promptText="Ej. 1350" />
              <Label fx:id="ayudaAltitud" text="Metros sobre el nivel del mar." styleClass="field-help" wrapText="true" />
            </VBox>
            <VBox styleClass="form-field">
              <Label text="Descripción" styleClass="form-label" />
              <TextArea fx:id="txtDescripcion" promptText="Descripción opcional del punto de control." prefRowCount="3" wrapText="true" />
            </VBox>
          </VBox>
          <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="crud-actions">
            <Button text="Cancelar" onAction="#cancelar" styleClass="secondary-button" />
            <Button fx:id="guardarButton" text="Agregar checkpoint" onAction="#guardarCheckpoint" styleClass="primary-button" />
          </HBox>
          <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
        </VBox>
      </VBox>
    </VBox>
  </content>
</ScrollPane>
