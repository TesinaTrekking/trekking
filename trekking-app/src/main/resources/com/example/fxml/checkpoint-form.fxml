<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controller.CheckpointFormController"
            stylesheets="@styles.css">

    <content>

        <VBox spacing="12.0">
            <children>
                <VBox spacing="2.0">
                    <Label fx:id="tituloLabel" text="Nuevo Checkpoint" styleClass="dialog-header-title"/>
                    <Label fx:id="subtituloLabel"
                           text="Ingrese los datos del nuevo punto de control para la bitácora."
                           wrapText="true" styleClass="dialog-header-subtitle"/>
                </VBox>
                <HBox fx:id="errorBanner" spacing="8.0" alignment="CENTER_LEFT"
                      visible="false" managed="false" styleClass="error-banner">
                    <Label text="⚠️" styleClass="error-banner-icon"/>
                    <Label fx:id="errorText" wrapText="true" styleClass="error-banner-text"/>
                </HBox>
                <GridPane hgap="12.0" vgap="12.0" styleClass="dialog-form-card">
                    <columnConstraints>
                        <ColumnConstraints halignment="LEFT" minWidth="140.0"/>
                        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nombre" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Ej. Checkpoint Alfa"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Hora (HH:mm)" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtHora" promptText="Ej. 14:30"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Latitud" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtLatitud" promptText="Ej. -31.4135"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Longitud" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtLongitud" promptText="Ej. -64.1810"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Descripción" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextArea fx:id="txtDescripcion" promptText="Descripción opcional de la parada o control..."
                              prefRowCount="3" prefColumnCount="22"
                              GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>

                <HBox spacing="8.0"
                      alignment="CENTER"
                      styleClass="crud-actions">

                    <Button fx:id="guardarButton" text="Guardar"
                            styleClass="action-edit"
                            onAction="#guardarCheckpoint"/>

                    <Button text="Cancelar"
                            styleClass="secondary-button"
                            onAction="#cancelar"/>

                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
        </VBox>

    </content>

</ScrollPane>
