<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<ScrollPane id="inventario-alta" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="pantalla-scroll" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.EquipamientoFormController" stylesheets="@styles.css">
  <content><VBox alignment="TOP_CENTER" styleClass="form-page"><VBox styleClass="form-content">
    <Label fx:id="tituloLabel" text="Nuevo elemento" styleClass="dialog-header-title"/>
    <Label text="Completa los datos del elemento de Inventario." styleClass="dialog-header-subtitle" wrapText="true"/>
    <VBox styleClass="form-card"><Label text="Datos del equipamiento" styleClass="form-section-title"/>
      <GridPane fx:id="formGrid" hgap="16" vgap="16" styleClass="form-grid">
        <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
        <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0"><Label text="Nombre *" styleClass="form-label"/><TextField fx:id="txtNombre"/></VBox>
        <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="Categoría *" styleClass="form-label"/><ComboBox fx:id="cmbCategoria" maxWidth="Infinity"/></VBox>
        <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Cantidad *" styleClass="form-label"/><TextField fx:id="txtCantidad"/><Label text="Ingrese la cantidad disponible en números." styleClass="field-help" wrapText="true"/></VBox>
        <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2"><Label text="Estado *" styleClass="form-label"/><ComboBox fx:id="cmbEstado" maxWidth="Infinity"/></VBox>
      </GridPane>
      <HBox spacing="8" styleClass="crud-actions"><Button fx:id="guardarButton" text="Crear elemento" onAction="#guardarEquipamiento" styleClass="primary-button"/><Button text="Cancelar" onAction="#cancelar" styleClass="secondary-button"/></HBox>
      <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    </VBox>
  </VBox></VBox></content>
</ScrollPane>
