<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ScrollPane id="inventario-alta" fitToWidth="true"
       hbarPolicy="NEVER"
       vbarPolicy="AS_NEEDED"
       xmlns="http://javafx.com/javafx/17"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.example.controller.EquipamientoFormController"
       stylesheets="@styles.css">

       <content>

              <VBox alignment="TOP_CENTER"
                     spacing="20.0">

                     <Label fx:id="tituloLabel" text="Nuevo equipamiento"
                            styleClass="dialog-header-title" />

                     <GridPane alignment="CENTER"
                            hgap="10.0"
                            vgap="15.0">

                            <Label text="Nombre:"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0" />

                            <TextField fx:id="txtNombre"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />
                            <Label
                                   text="Ingrese un nombre descriptivo para identificar el equipamiento."
                                   styleClass="field-help"
                                   wrapText="true"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1" />


                            <Label text="Categoría:"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2" />

                            <ComboBox fx:id="cmbCategoria"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2" />
                            <Label
                                   text="Seleccione la categoría que corresponda al tipo de equipamiento."
                                   styleClass="field-help"
                                   wrapText="true"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3" />


                            <Label text="Cantidad:"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4" />

                            <TextField fx:id="txtCantidad"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4" />
                            <Label text="Ingrese la cantidad disponible en números."
                                   styleClass="field-help"
                                   wrapText="true"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5" />


                            <Label text="Estado:"
                                   styleClass="form-label"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="6" />

                            <ComboBox fx:id="cmbEstado"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="6" />
                            <Label text="Seleccione el estado actual del equipamiento."
                                   styleClass="field-help"
                                   wrapText="true"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="7" />


                     </GridPane>

                     <HBox spacing="8.0"
                            alignment="CENTER"
                            styleClass="crud-actions">

                            <Button fx:id="guardarButton" text="Guardar"
                                   styleClass="action-edit"
                                   onAction="#guardarEquipamiento" />

                            <Button text="Cancelar"
                                   styleClass="secondary-button"
                                   onAction="#cancelar" />

                     </HBox>
                     <padding>
                            <Insets top="24.0"
                                   right="24.0"
                                   bottom="24.0"
                                   left="24.0" />
                     </padding>
              </VBox>

       </content>

</ScrollPane>
