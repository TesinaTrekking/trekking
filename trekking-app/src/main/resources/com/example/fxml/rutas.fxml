<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<ScrollPane fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="pantalla-scroll"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.controller.RutaController"
        stylesheets="@styles.css">

        <content>

                <VBox alignment="TOP_CENTER"
                        spacing="10.0"
                        prefWidth="980.0"
                        prefHeight="800.0">

                        <padding>
                                <Insets top="20.0"
                                        right="20.0"
                                        bottom="20.0"
                                        left="20.0" />
                        </padding>

                        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="top-bar">
                                <VBox spacing="3.0">
                                        <Label text="Listado de Rutas" styleClass="brand-title" />
                                        <Label text="Administración de rutas" styleClass="brand-subtitle" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox spacing="8.0" alignment="CENTER_RIGHT" styleClass="toolbar-actions">
                                        <Button text="Agregar ruta"
                                                onAction="#nuevaRuta"
                                                styleClass="action-add" />
                                        <Button text="Editar"
                                                onAction="#editarRuta"
                                                styleClass="action-edit" />
                                        <Button fx:id="eliminarButton"
                                                text="Eliminar"
                                                onAction="#eliminarRuta"
                                                styleClass="action-delete" />
                                </HBox>
                        </HBox>

                        <HBox spacing="10.0"
                                alignment="CENTER">

                                <TextField fx:id="buscarField"
                                        promptText="Buscar por nombre"
                                        prefWidth="200.0" />

                                <ComboBox fx:id="filtroTerrenoCombo"
                                        prefWidth="150.0"
                                        promptText="Terreno" />

                                <ComboBox fx:id="filtroDificultadTecnicaCombo"
                                        prefWidth="150.0"
                                        promptText="Dificultad técnica" />

                                <ComboBox fx:id="filtroDificultadFisicaCombo"
                                        prefWidth="150.0"
                                        promptText="Dificultad física" />

                                <CheckBox fx:id="mostrarInactivasCheckBox"
                                        text="Mostrar inactivas" />

                        </HBox>

                        <TableView fx:id="tablaRutas"
                                VBox.vgrow="ALWAYS"
                                prefHeight="430.0"
                                prefWidth="940.0">

                                <columns>

                                        <TableColumn fx:id="colId"
                                                prefWidth="50.0"
                                                text="ID" />

                                        <TableColumn fx:id="colNombre"
                                                prefWidth="150.0"
                                                text="Nombre" />

                                        <TableColumn fx:id="colAltitudMaxima"
                                                prefWidth="120.0"
                                                text="Altitud máxima" />

                                        <TableColumn fx:id="colTipoTerreno"
                                                prefWidth="130.0"
                                                text="Tipo de terreno" />

                                        <TableColumn fx:id="colDificultadTecnica"
                                                prefWidth="130.0"
                                                text="Dificultad técnica" />

                                        <TableColumn fx:id="colDificultadFisica"
                                                prefWidth="130.0"
                                                text="Dificultad física" />

                                </columns>

                        </TableView>

                        <Label text="Checkpoints de la ruta seleccionada"
                                style="-fx-font-size: 16; -fx-font-weight: bold;" />

                        <ListView fx:id="checkpointsRutaListView"
                                prefHeight="120.0"
                                prefWidth="700.0"
                                VBox.vgrow="NEVER" />
                        <Label text="Equipamiento minimo requerido"
                                style="-fx-font-size: 16; -fx-font-weight: bold;" />

                        <ListView fx:id="equipamientosListView"
                                prefHeight="120.0"
                                prefWidth="700.0"
                                VBox.vgrow="NEVER" />

                </VBox>
        </content>

</ScrollPane>