<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.ListaClientesController"
      stylesheets="@styles.css">
    <children>
        <Label text="Clientes" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="buscarField" promptText="Buscar por DNI, nombre o apellido"
                       prefWidth="300.0"/>
            <CheckBox fx:id="mostrarInactivosCheckBox"
                      text="Mostrar clientes dados de baja"/>
        </HBox>
        <TableView fx:id="tablaClientes" prefHeight="300.0" prefWidth="600.0"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDni" prefWidth="90.0" text="DNI"/>
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre"/>
                <TableColumn fx:id="colApellido" prefWidth="150.0" text="Apellido"/>
                <TableColumn fx:id="colFechaNacimiento" prefWidth="120.0" text="Nacimiento"/>
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email"/>
                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Telefono"/>
                <TableColumn fx:id="colSexo" prefWidth="120.0" text="Sexo"/>
                <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo"/>
            </columns>
        </TableView>
        <HBox spacing="10.0" alignment="CENTER">
            <Button text="Volver al Dashboard" onAction="#volverDashboard"
                    styleClass="secondary-button"/>
            <Button text="Nuevo cliente" onAction="#irAgregarCliente"
                    styleClass="primary-button"
                    style="-fx-padding: 10px 20px; -fx-font-size: 12;"/>
            <Button text="Editar" onAction="#editarCliente"
                    styleClass="secondary-button"
                    style="-fx-padding: 10px 20px; -fx-font-size: 12;"/>
            <Button text="Abrir ficha" onAction="#abrirFichaMedica"
                    styleClass="secondary-button"
                    style="-fx-padding: 10px 20px; -fx-font-size: 12;"/>
            <Button text="Eliminar" onAction="#eliminarCliente"
                    styleClass="danger-button"
                    style="-fx-padding: 10px 20px; -fx-font-size: 12;"/>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>
