<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
      styleClass="pantalla-scroll" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.ListaClientesController"
      stylesheets="@styles.css">
    <content>
    <VBox alignment="TOP_CENTER" spacing="10.0">
    <children>
        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="top-bar">
            <VBox spacing="3.0">
                <Label text="Clientes" styleClass="brand-title"/>
                <Label text="Administración de clientes" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8.0" alignment="CENTER_RIGHT" styleClass="toolbar-actions">
                <Button text="+ Nuevo Cliente" onAction="#irAgregarCliente"
                        styleClass="action-add"/>
            </HBox>
        </HBox>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="buscarField" promptText="Buscar por DNI, nombre o apellido"
                       prefWidth="300.0"/>
            <CheckBox fx:id="mostrarInactivosCheckBox"
                      text="Mostrar clientes dados de baja"/>
        </HBox>
        <TableView fx:id="tablaClientes" prefHeight="300.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colDni" prefWidth="90.0" text="DNI"/>
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre"/>
                <TableColumn fx:id="colApellido" prefWidth="150.0" text="Apellido"/>
                <TableColumn fx:id="colFechaNacimiento" prefWidth="120.0" text="Nacimiento"/>
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email"/>
                <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Telefono"/>
                <TableColumn fx:id="colSexo" prefWidth="120.0" text="Sexo"/>
                <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo"/>
                <TableColumn fx:id="colAcciones" prefWidth="110.0" text="Acciones"/>
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" styleClass="table-add-row">
            <Button fx:id="filaAltaButton" text="+ Nuevo Cliente"
                    onAction="#irAgregarCliente" styleClass="table-add-button"/>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    </VBox>
    </content>
</ScrollPane>
