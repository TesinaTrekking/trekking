<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.controller.DashboardController"
        stylesheets="@styles.css">

    <!-- HEADER -->
    <top>
        <HBox
                fx:id="header"
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="dashboard-header">

            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <Label
                    text="Trekking App"
                    styleClass="dashboard-title"/>

            <Label
                    text="Sistema de gestión de trekking"
                    styleClass="dashboard-subtitle"/>

        </HBox>
    </top>

    <center>
        <VBox
                fx:id="moduleArea"
                alignment="CENTER_LEFT"
                spacing="16"
                styleClass="dashboard-module-area">

            <padding>
                <Insets top="48" right="56" bottom="48" left="56"/>
            </padding>

            <Label
                    text="Bienvenido a Trekking"
                    styleClass="dashboard-section-title"/>

            <Label
                    text="Seleccioná una sección desde el menú lateral para gestionar rutas, checkpoints, equipamiento, clientes y recorridos."
                    wrapText="true"
                    maxWidth="620"
                    styleClass="dashboard-welcome"/>

        </VBox>
    </center>

</BorderPane>