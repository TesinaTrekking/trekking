<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.controller.DashboardController"
        stylesheets="@styles.css">

    <!-- HEADER -->
    <top>
        <HBox
                fx:id="header"
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="dashboard-header">

            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <Label
                    text="Trekking App"
                    styleClass="dashboard-title"/>

            <Label
                    text="Sistema de gestión de trekking"
                    styleClass="dashboard-subtitle"/>

        </HBox>
    </top>

    <!-- ÁREA PRINCIPAL DE MÓDULOS -->
    <center>
        <VBox
                fx:id="moduleArea"
                spacing="24"
                styleClass="dashboard-module-area">

            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Label
                    text="Módulos"
                    styleClass="dashboard-section-title"/>

            <FlowPane
                    fx:id="moduleContainer"
                    hgap="20"
                    vgap="20"
                    prefWrapLength="700">

                <Button
                        text="Rutas"
                        prefWidth="180"
                        prefHeight="100"
                        onAction="#abrirRutas"
                        styleClass="module-button"/>

                <Button
                        text="Checkpoints"
                        prefWidth="180"
                        prefHeight="100"
                        onAction="#abrirCheckpoints"
                        styleClass="module-button"/>

                <Button
                        text="Equipamiento"
                        prefWidth="180"
                        prefHeight="100"
                        onAction="#abrirEquipamiento"
                        styleClass="module-button"/>


                <Button
                        text="Clientes"
                        prefWidth="180"
                        prefHeight="100"
                        onAction="#abrirClientes"
                        styleClass="module-button"/>

                <Button
                        text="Recorridos"
                        prefWidth="180"
                        prefHeight="100"
                        onAction="#abrirRecorridos"
                        styleClass="module-button"/>

            </FlowPane>

        </VBox>
    </center>

</BorderPane>