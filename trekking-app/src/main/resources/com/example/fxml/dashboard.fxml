<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.controller.DashboardController"
    stylesheets="@styles.css">

    <!-- HEADER -->
    <top>
        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="top-bar">
            <VBox spacing="3.0">
                <Label text="Panel de inicio" styleClass="brand-title" />
                <Label text="Resumen de próximos recorridos" styleClass="brand-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>
    <center>
        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="pantalla-scroll">
            <content>
                <VBox spacing="16">

                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24" />
                    </padding>

                    <Label
                        fx:id="errorLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"
                        maxWidth="900"
                        styleClass="error-banner-text" />


                    <!-- KPI CARDS -->
                    <HBox spacing="12">
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="4">
                            <Label text="Rutas activas" styleClass="kpi-caption" />
                            <Label fx:id="kpiRutas" text="—" styleClass="kpi-value" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="4">
                            <Label text="Clientes activos" styleClass="kpi-caption" />
                            <Label fx:id="kpiClientes" text="—" styleClass="kpi-value" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="4">
                            <Label text="Recorridos próximos (7 días)" styleClass="kpi-caption" />
                            <Label fx:id="kpiRecorridos" text="—" styleClass="kpi-value" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card" spacing="4">
                            <Label text="Equipamiento crítico" styleClass="kpi-caption" />
                            <Label fx:id="kpiEquipo" text="—" styleClass="kpi-value" />
                        </VBox>
                    </HBox>

                    <!-- PROXIMOS RECORRIDOS -->
                    <VBox spacing="8" styleClass="dashboard-card">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label
                                text="Próximos recorridos"
                                styleClass="card-title" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button
                                text="Ver todos →"
                                onAction="#onVerTodosRecorridos"
                                styleClass="clear-search-button" />
                        </HBox>
                        <TableView
                            fx:id="tablaProximos"
                            prefHeight="260.0">
                            <columns>
                                <TableColumn
                                    fx:id="colFecha"
                                    text="Fecha"
                                    prefWidth="110.0" />
                                <TableColumn
                                    fx:id="colRuta"
                                    text="Ruta"
                                    prefWidth="220.0" />
                                <TableColumn
                                    fx:id="colHorario"
                                    text="Horario"
                                    prefWidth="130.0" />
                                <TableColumn
                                    fx:id="colParticipantes"
                                    text="Part."
                                    prefWidth="70.0" />
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>