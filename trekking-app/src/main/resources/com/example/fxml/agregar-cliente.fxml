<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane id="cliente-alta" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.controller.AgregarClienteController"
    stylesheets="@styles.css"
    styleClass="pantalla-scroll">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="form-page form-card">
            <Label text="Nuevo cliente"
                styleClass="dialog-header-title" />
            <Label
                text="Los campos marcados con * son obligatorios. El email y el contacto de emergencia son opcionales."
                styleClass="dialog-header-subtitle" />
<GridPane hgap="12" vgap="8" styleClass="form-grid">
    <!-- DNI -->
    <Label text="DNI *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="0" />
    <TextField fx:id="dniField" promptText="7 u 8 números"
               GridPane.columnIndex="1" GridPane.rowIndex="0" />

    <!-- NUEVO: aclara el formato admitido por ClienteValidator. -->
    <Label text="Entre 7 y 8 números, sin puntos."
           styleClass="field-help" wrapText="true"
           GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <!-- Nombre -->
    <Label text="Nombre *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="2" />
    <TextField fx:id="nombreField"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <!-- Apellido -->
    <Label text="Apellido *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <TextField fx:id="apellidoField"
               GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <!-- Fecha de nacimiento -->
    <Label text="Fecha de nacimiento *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="4" />
    <DatePicker fx:id="fechaNacimientoPicker"
                GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <!-- Email -->
    <Label text="Email (opcional)" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="5" />
    <TextField fx:id="emailField"
               GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <!-- NUEVO: aclara que el email no es obligatorio. -->
    <Label text="Opcional. Si lo completa, ingrese un correo válido (máximo 100 caracteres)."
           styleClass="field-help" wrapText="true"
           GridPane.columnIndex="1" GridPane.rowIndex="6" />

    <!-- Teléfono -->
    <Label text="Teléfono *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="7" />
    <TextField fx:id="telefonoField"
               GridPane.columnIndex="1" GridPane.rowIndex="7" />

    <!-- Sexo -->
    <Label text="Sexo *" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="8" />
    <ComboBox fx:id="sexoComboBox" maxWidth="Infinity"
              GridPane.columnIndex="1" GridPane.rowIndex="8" />

    <!-- Contacto de emergencia -->
    <Label text="Contacto de emergencia (opcional)"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="9" />
    <TextField fx:id="contactoNombreField"
               GridPane.columnIndex="1" GridPane.rowIndex="9" />

    <!-- Teléfono de emergencia -->
    <Label text="Tel. emergencia (opcional)"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="10" />
    <TextField fx:id="contactoTelefonoField"
               GridPane.columnIndex="1" GridPane.rowIndex="10" />

    <!-- Relación -->
    <Label text="Relación (opcional)" styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="11" />
    <TextField fx:id="contactoRelacionField"
               GridPane.columnIndex="1" GridPane.rowIndex="11" />

    <!-- NUEVO: explica que los tres campos son opcionales como conjunto. -->
    <Label text="Opcional. Si completa un dato, deberá completar nombre, teléfono y relación."
           styleClass="field-help" wrapText="true"
           GridPane.columnIndex="1" GridPane.rowIndex="12" />

    <!-- Ficha médica -->
    <Label text="Ficha médica (PDF, máximo 2 MB)"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="13" />
    <HBox spacing="8" alignment="CENTER_LEFT"
          GridPane.columnIndex="1" GridPane.rowIndex="13">
        <Button text="Cargar ficha" onAction="#seleccionarFichaMedica" />
        <Label fx:id="fichaMedicaLabel" text="Sin archivo seleccionado"
               wrapText="true" />
    </HBox>

    <!-- Autorización de menores -->
    <Label text="Autorización de menores"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="14" />
    <CheckBox fx:id="autorizacionMenoresCheckBox"
              onAction="#cambiarAutorizacionMenores"
              text="Autorización correspondiente"
              GridPane.columnIndex="1" GridPane.rowIndex="14" />

    <!-- NUEVO: explica cuándo corresponde completar los datos del tutor. -->
    <Label text="Para menores de 18 años, marque la autorización y complete los datos del tutor."
           styleClass="field-help" wrapText="true"
           GridPane.columnIndex="1" GridPane.rowIndex="15" />

    <!-- Datos del tutor: visibilidad controlada por el controlador. -->
    <Label fx:id="tutorNombreLabel" text="Nombre del tutor"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="16" />
    <TextField fx:id="tutorNombreField"
               GridPane.columnIndex="1" GridPane.rowIndex="16" />

    <Label fx:id="tutorApellidoLabel" text="Apellido del tutor"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="17" />
    <TextField fx:id="tutorApellidoField"
               GridPane.columnIndex="1" GridPane.rowIndex="17" />

    <Label fx:id="tutorDniLabel" text="DNI del tutor"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="18" />
    <TextField fx:id="tutorDniField"
               GridPane.columnIndex="1" GridPane.rowIndex="18" />

    <Label fx:id="tutorTelefonoLabel" text="Teléfono del tutor"
           styleClass="form-label"
           GridPane.columnIndex="0" GridPane.rowIndex="19" />
    <TextField fx:id="tutorTelefonoField"
               GridPane.columnIndex="1" GridPane.rowIndex="19" />
</GridPane>
            <HBox spacing="8.0" alignment="CENTER" styleClass="crud-actions">
                <Button text="Guardar" onAction="#guardarCliente"
                    styleClass="primary-button" />
                <Button text="Cancelar" onAction="#irListaClientes"
                    styleClass="secondary-button" />
            </HBox>
            <padding>
                <Insets bottom="40.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </content>
</ScrollPane>
