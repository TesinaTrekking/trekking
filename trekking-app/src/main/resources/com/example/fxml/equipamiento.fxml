<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.EquipamientoController"
      stylesheets="@styles.css">

    <children>

        <HBox spacing="16.0"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <VBox spacing="3.0">
                <Label text="Inventario"
                       styleClass="brand-title"/>
                <Label text="Administración de elementos"
                       styleClass="brand-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8.0"
                  alignment="CENTER_RIGHT"
                  styleClass="toolbar-actions">

                <Button text="+ Nuevo elemento"
                        styleClass="action-add"
                        onAction="#nuevoEquipamiento"/>

                <Button text="Editar"
                        styleClass="action-edit"
                        onAction="#editarEquipamiento"/>

                <Button text="Eliminar"
                        styleClass="action-delete"
                        onAction="#eliminarEquipamiento"/>

                <Button text="Dados de baja"
                        styleClass="secondary-button"
                        onAction="#mostrarEquipamientoBaja"/>

            </HBox>
        </HBox>

        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, categoría o estado" />

        <TableView fx:id="tablaEquipamiento"
                   prefHeight="300.0"
                   prefWidth="600.0"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="70.0"/>

                <TableColumn fx:id="colNombre"
                             text="Elemento"
                             prefWidth="250.0"/>

                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="200.0"/>

                <TableColumn fx:id="colCantidad"
                             text="Total"
                             prefWidth="90.0"/>

                <TableColumn fx:id="colReservada" text="Reservada" prefWidth="100.0"/>
                <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="100.0"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="150.0"/>
            </columns>

        </TableView>

    </children>

    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0"/>
    </padding>

</VBox>
