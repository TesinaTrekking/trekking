<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane id="inventario" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
      styleClass="pantalla-scroll"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.EquipamientoController"
      stylesheets="@styles.css">
    <content>
    <VBox alignment="TOP_CENTER" spacing="10.0">

    <children>

        <HBox spacing="16.0"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <VBox spacing="3.0">
                <Label text="Inventario"
                       styleClass="brand-title"/>
                <Label text="Administración de elementos"
                       styleClass="brand-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8.0"
                  alignment="CENTER_RIGHT"
                  styleClass="toolbar-actions">

            </HBox>
        </HBox>

        <HBox styleClass="list-filter-bar">
            <StackPane styleClass="search-container" HBox.hgrow="ALWAYS">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, categoría o estado"
                           styleClass="list-search-field" />
            </StackPane>
            <ComboBox fx:id="estadoFiltroCombo" prefWidth="170.0"
                      promptText="Estado" styleClass="list-filter-control" />
            <Button text="+ Nuevo elemento" styleClass="action-add" onAction="#nuevoEquipamiento" />
        </HBox>

        <TableView fx:id="tablaEquipamiento"
                   prefHeight="300.0"
                   prefWidth="600.0">

            <columns>
                <TableColumn fx:id="colNombre"
                             text="Elemento"
                             prefWidth="250.0"/>

                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="200.0"/>

                <TableColumn fx:id="colCantidad"
                             text="Total"
                             prefWidth="90.0"/>

                <TableColumn fx:id="colReservada" text="Reservada" prefWidth="100.0"/>
                <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="100.0"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="150.0"/>
                <TableColumn fx:id="colAcciones" text="" prefWidth="70.0"/>
            </columns>

        </TableView>


    </children>

    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0"/>
    </padding>

    </VBox>
    </content>
</ScrollPane>
