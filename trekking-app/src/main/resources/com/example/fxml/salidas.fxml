<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane id="salidas" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
      styleClass="pantalla-scroll" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.SalidasController"
      stylesheets="@styles.css">
    <content>
    <VBox spacing="16">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="top-bar">
        <VBox spacing="4"><Label text="Salidas" styleClass="brand-title"/>
            <Label text="Planificación y seguimiento de actividades" styleClass="brand-subtitle"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="tarjetaProximas" onAction="#irASalidas" styleClass="kpi-action-card" HBox.hgrow="ALWAYS"/>
        <Button fx:id="tarjetaRutas" onAction="#irARutas" styleClass="kpi-action-card" HBox.hgrow="ALWAYS"/>
        <Button fx:id="tarjetaClientes" onAction="#irAClientes" styleClass="kpi-action-card" HBox.hgrow="ALWAYS"/>
        <Button fx:id="tarjetaInventario" onAction="#irAInventario" styleClass="kpi-action-card" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox styleClass="list-filter-bar">
        <StackPane styleClass="search-container" HBox.hgrow="ALWAYS">
            <TextField fx:id="buscarField" promptText="Buscar por Ruta o Cliente" styleClass="list-search-field"/>
        </StackPane>
        <ComboBox fx:id="estadoFiltro" prefWidth="180" promptText="Estado" styleClass="list-filter-control"/>
        <Button text="Nueva Salida" onAction="#iniciarWizard" styleClass="action-add"/>
    </HBox>
    <TableView fx:id="tablaSalidas" prefHeight="500">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="160"/>
            <TableColumn fx:id="colRuta" text="Ruta" prefWidth="320"/>
            <TableColumn fx:id="colParticipantes" text="Participantes" prefWidth="260"/>
            <TableColumn fx:id="colEquipamiento" text="Equipamiento asignado" prefWidth="260"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="160"/>
            <TableColumn fx:id="colAcciones" text="" prefWidth="125"/>
        </columns>
    </TableView>
    </VBox>
    </content>
</ScrollPane>
