<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controller.CheckpointController"
      stylesheets="@styles.css">
    <children>
        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="top-bar">
            <VBox spacing="3.0">
                <Label text="Checkpoints" styleClass="brand-title"/>
                <Label text="Puntos de control de ruta" styleClass="brand-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8.0" alignment="CENTER_RIGHT" styleClass="toolbar-actions">
                <Button text="+ Nuevo Checkpoint" onAction="#mostrarCrear"
                        styleClass="action-add"/>
                <Button fx:id="editarButton" text="Editar" onAction="#editarSeleccionado"
                        styleClass="action-edit"/>
                <Button fx:id="eliminarButton" text="Eliminar" onAction="#eliminarSeleccionado"
                        styleClass="action-delete"/>
            </HBox>
        </HBox>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <StackPane styleClass="search-container">
                <TextField fx:id="filterField" promptText="Filtrar por nombre, hora o descripción…"
                           prefWidth="300.0" styleClass="search-field"/>
                <Button fx:id="clearButton" text="✕" onAction="#limpiarFiltro"
                        StackPane.alignment="CENTER_RIGHT"
                        styleClass="clear-search-button"/>
            </StackPane>
        </HBox>
        <TableView fx:id="tablaCheckpoints" prefHeight="400.0" prefWidth="600.0"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colHora" prefWidth="85.0" text="Hora"/>
                <TableColumn fx:id="colNombre" prefWidth="240.0" text="Checkpoint / Nombre"/>
                <TableColumn fx:id="colLatitud" prefWidth="120.0" text="Latitud"/>
                <TableColumn fx:id="colLongitud" prefWidth="120.0" text="Longitud"/>
                <TableColumn fx:id="colDescripcion" prefWidth="200.0" text="Descripción"/>
            </columns>
            <placeholder>
                <Label text='No hay checkpoints registrados. Use "+ Nuevo Checkpoint" para agregar uno.'
                       styleClass="table-placeholder"/>
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT" styleClass="footer-container">
            <Label fx:id="counterLabel" styleClass="counter-badge"/>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>
