<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<ScrollPane id="ruta-alta" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="pantalla-scroll" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.RutaFormController" stylesheets="@styles.css">
  <content>
    <VBox alignment="TOP_CENTER" styleClass="form-page">
      <VBox styleClass="form-content">
        <Label fx:id="tituloForm" text="Nueva ruta" styleClass="dialog-header-title" />
        <Label text="Completa la información principal de la Ruta." styleClass="dialog-header-subtitle" wrapText="true" />
        <VBox styleClass="form-card">
          <Label text="Información de la Ruta" styleClass="form-section-title" />
          <GridPane fx:id="formGrid" hgap="16" vgap="12" styleClass="form-grid">
            <columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
            <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0">
              <Label text="Nombre *" styleClass="form-label"/><TextField fx:id="nombreField" promptText="Ej: Cerro Champaquí"/><Label text="Letras, números y espacios." styleClass="field-help" wrapText="true"/>
            </VBox>
            <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="Altitud máxima (m) *" styleClass="form-label"/><TextField fx:id="altitudMaximaField" promptText="Ej: 1200"/><Label text="Metros. Debe ser mayor o igual que 0." styleClass="field-help" wrapText="true"/></VBox>
            <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Tipo de terreno *" styleClass="form-label"/><ComboBox fx:id="tipoTerrenoCombo" promptText="Seleccione un tipo" maxWidth="Infinity"/></VBox>
            <VBox styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label text="Dificultad técnica *" styleClass="form-label"/><ComboBox fx:id="dificultadTecnicaCombo" promptText="Seleccione dificultad" maxWidth="Infinity"/></VBox>
            <VBox styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Dificultad física *" styleClass="form-label"/><ComboBox fx:id="dificultadFisicaCombo" promptText="Seleccione dificultad" maxWidth="Infinity"/></VBox>
          </GridPane>
          <Label text="Podrás configurar el itinerario y sus checkpoints después de crear la ruta." styleClass="field-help" wrapText="true" />
          <HBox spacing="8" styleClass="crud-actions">
            <Button fx:id="guardarButton" text="Crear ruta" onAction="#guardarRuta" styleClass="primary-button"/>
            <Button text="Cancelar" onAction="#volverListado" styleClass="secondary-button"/>
          </HBox>
          <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
        </VBox>
      </VBox>
    </VBox>
  </content>
</ScrollPane>
