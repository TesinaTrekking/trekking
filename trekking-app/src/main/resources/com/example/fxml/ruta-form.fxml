<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER"
       spacing="20.0"
       xmlns="http://javafx.com/javafx/17"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.example.controller.RutaFormController"
       stylesheets="@styles.css">

       <Label fx:id="tituloForm"
              text="Agregar Nueva Ruta"
              style="-fx-font-size: 20; -fx-font-weight: bold;" />

       <GridPane alignment="CENTER"
              hgap="10"
              vgap="15">

              <children>

                     <Label text="Nombre:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0" />

                     <TextField fx:id="nombreField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0" />

                     <Label text="Letras, números y espacios."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1" />


                     <Label text="Latitud inicial:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2" />

                     <TextField fx:id="latitudInicialField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2" />

                     <Label text="Número entre -90 y 90."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3" />


                     <Label text="Longitud inicial:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="4" />

                     <TextField fx:id="longitudInicialField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4" />

                     <Label text="Número entre -180 y 180."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="5" />


                     <Label text="Altitud máxima:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="6" />

                     <TextField fx:id="altitudMaximaField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="6" />

                     <Label text="Número mayor o igual que 0."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="7" />


                     <Label text="Tipo de terreno:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="8" />

                     <ComboBox fx:id="tipoTerrenoCombo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="8" />

                     <Label text="Selecciona una opción de la lista."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="9" />


                     <Label text="Dificultad técnica:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="10" />

                     <ComboBox fx:id="dificultadTecnicaCombo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="10" />

                     <Label text="Selecciona Baja, Media o Alta."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="11" />


                     <Label text="Dificultad física:"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="12" />

                     <ComboBox fx:id="dificultadFisicaCombo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="12" />

                     <Label text="Selecciona Baja, Media o Alta."
                            styleClass="field-help"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="13" />
              </children>

       </GridPane>

       <HBox spacing="10.0" alignment="CENTER">

              <Button text="Guardar"
                     onAction="#guardarRuta"
                     style="-fx-padding: 10px 20px;" />

              <Button text="Cancelar"
                     onAction="#volverListado"
                     style="-fx-padding: 10px 20px;" />

       </HBox>

       <padding>
              <Insets bottom="20.0"
                     left="20.0"
                     right="20.0"
                     top="20.0" />
       </padding>

</VBox>