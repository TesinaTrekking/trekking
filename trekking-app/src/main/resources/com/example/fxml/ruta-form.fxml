<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
       hbarPolicy="NEVER"
       vbarPolicy="AS_NEEDED"
       styleClass="pantalla-scroll"
       xmlns="http://javafx.com/javafx/17"
       xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.example.controller.RutaFormController"
       stylesheets="@styles.css">

       <content>

              <VBox alignment="TOP_CENTER"
                     spacing="20.0">

                     <Label fx:id="tituloForm"
                            text="Agregar Nueva Ruta"
                            style="-fx-font-size: 20; -fx-font-weight: bold;" />

                     <GridPane alignment="CENTER"
                            hgap="10"
                            vgap="15">

                            <Label text="Nombre:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0" />

                            <TextField fx:id="nombreField"
                                   promptText="Ej: Cerro Champaquí"
                                   prefWidth="300.0"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0" />

                            <Label text="Letras, números y espacios."
                                   styleClass="field-help"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1" />


                            <Label text="Altitud máxima:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="2" />

                            <TextField fx:id="altitudMaximaField"
                                   promptText="Ej: 1200"
                                   prefWidth="300.0"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2" />

                            <Label text="Metros. Debe ser mayor o igual que 0."
                                   styleClass="field-help"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3" />


                            <Label text="Tipo de terreno:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="4" />

                            <ComboBox fx:id="tipoTerrenoCombo"
                                   prefWidth="300.0"
                                   promptText="Seleccione un tipo"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4" />

                            <Label text="Seleccione una opción de la lista."
                                   styleClass="field-help"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="5" />


                            <Label text="Dificultad técnica:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="6" />

                            <ComboBox fx:id="dificultadTecnicaCombo"
                                   prefWidth="300.0"
                                   promptText="Seleccione dificultad"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="6" />

                            <Label text="Seleccione Baja, Media o Alta."
                                   styleClass="field-help"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="7" />


                            <Label text="Dificultad física:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="8" />

                            <ComboBox fx:id="dificultadFisicaCombo"
                                   prefWidth="300.0"
                                   promptText="Seleccione dificultad"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="8" />

                            <Label text="Seleccione Baja, Media o Alta."
                                   styleClass="field-help"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="9" />

                     </GridPane>

                     <Label text="Checkpoints de la ruta"
                            style="-fx-font-size: 16; -fx-font-weight: bold;" />


                     <HBox alignment="CENTER"
                            spacing="10.0">

                            <ComboBox fx:id="checkpointCombo"
                                   prefWidth="350.0"
                                   promptText="Seleccione un checkpoint" />

                            <Button fx:id="agregarCheckpointButton"
                                   text="Agregar"
                                   onAction="#agregarCheckpoint"
                                   styleClass="action-add" />

                     </HBox>


                     <ListView fx:id="checkpointsListView"
                            prefWidth="500.0"
                            prefHeight="250.0" />


                     <HBox alignment="CENTER"
                            spacing="10.0">

                            <Button fx:id="quitarCheckpointButton"
                                   text="Quitar"
                                   onAction="#quitarCheckpoint"
                                   styleClass="action-delete" />

                            <Button fx:id="subirCheckpointButton"
                                   text="Subir"
                                   onAction="#subirCheckpoint" />

                            <Button fx:id="bajarCheckpointButton"
                                   text="Bajar"
                                   onAction="#bajarCheckpoint" />

                     </HBox>
                     <TitledPane text="Equipamiento requerido"
                            expanded="true"
                            prefWidth="600.0">

                            <content>

                                   <VBox spacing="10.0">

                                          <HBox alignment="CENTER"
                                                 spacing="10.0">

                                                 <ComboBox fx:id="equipamientoCombo"
                                                        prefWidth="280.0"
                                                        promptText="Seleccione equipamiento" />

                                                 <TextField fx:id="cantidadEquipamientoField"
                                                        prefWidth="100.0"
                                                        promptText="Cantidad" />

                                                 <Button fx:id="agregarEquipamientoButton"
                                                        text="Agregar"
                                                        onAction="#agregarEquipamiento"
                                                        styleClass="action-add" />

                                          </HBox>

                                          <ListView fx:id="equipamientosListView"
                                                 prefHeight="180.0" />

                                          <HBox alignment="CENTER"
                                                 spacing="10.0">

                                                 <Button fx:id="quitarEquipamientoButton"
                                                        text="Quitar"
                                                        onAction="#quitarEquipamiento"
                                                        styleClass="action-delete" />

                                          </HBox>

                                   </VBox>

                            </content>

                     </TitledPane>


                     <HBox alignment="CENTER"
                            spacing="8.0"
                            styleClass="crud-actions">

                            <Button fx:id="guardarRutaButton" text="Guardar"
                                   onAction="#guardarRuta"
                                   styleClass="action-edit" />

                            <Button text="Cancelar"
                                   onAction="#volverListado"
                                   styleClass="secondary-button" />

                     </HBox>


                     <padding>
                            <Insets top="20.0"
                                   right="20.0"
                                   bottom="20.0"
                                   left="20.0" />
                     </padding>

              </VBox>

       </content>

</ScrollPane>